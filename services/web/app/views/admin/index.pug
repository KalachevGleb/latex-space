extends ../layout-marketing
include ../_mixins/bookmarkable_tabset

block content
	#main-content.content.content-alt
		.container
			.row
				.col-sm-12
					.card
						.card-body
							.page-header
								h1 #{translate("admin_panel")}
							.ol-tabs(data-ol-bookmarkable-tabset)
								.nav-tabs-container
									ul.nav.nav-tabs.align-left(role='tablist')
										+bookmarkable-tabset-header('system-messages', translate("system_messages"), true)
										+bookmarkable-tabset-header('site-settings', translate("settings"))
										+bookmarkable-tabset-header('service-api', 'Service API')
										+bookmarkable-tabset-header('open-sockets', translate("open_sockets"))
										+bookmarkable-tabset-header('open-close-editor', translate("open_close_editor"))
										if hasFeature('saas')
											+bookmarkable-tabset-header('tpds', translate("tpds_dropbox_management"))

								.tab-content
									.tab-pane.active(role='tabpanel' id='system-messages')
										each message in systemMessages
											ul.system-messages
												li.system-message.row-spaced #{message.content}
										hr
										form(method='post' action='/admin/messages')
											input(name='_csrf' type='hidden' value=csrfToken)
											.form-group
												label.form-label(for='system-message') #{translate("message")}
												input#system-message.form-control(
													name='content'
													type='text'
													required
												)
											button.btn.btn-primary(type='submit') #{translate("post_message")}
										hr
										form(method='post' action='/admin/messages/clear')
											input(name='_csrf' type='hidden' value=csrfToken)
											button.btn.btn-danger(type='submit') #{translate("clear_all_messages")}

									.tab-pane(role='tabpanel' id='site-settings')
										.row-spaced
											form#site-settings-form(method='post' action='/admin/settings')
												input(name='_csrf' type='hidden' value=csrfToken)
												.form-group
													label.form-label(for='default-language') #{translate("default_interface_language")}
													select#default-language.form-control(name='defaultLanguage' onchange='markFormDirty()')
														option(value='en' selected=(defaultLanguage === 'en')) English
														option(value='ru' selected=(defaultLanguage === 'ru')) Русский
														option(value='es' selected=(defaultLanguage === 'es')) Español
														option(value='de' selected=(defaultLanguage === 'de')) Deutsch
														option(value='fr' selected=(defaultLanguage === 'fr')) Français
														option(value='pt' selected=(defaultLanguage === 'pt')) Português
														option(value='it' selected=(defaultLanguage === 'it')) Italiano
														option(value='zh-CN' selected=(defaultLanguage === 'zh-CN')) 中文 (简体)
														option(value='ja' selected=(defaultLanguage === 'ja')) 日本語
														option(value='ko' selected=(defaultLanguage === 'ko')) 한국어
													p.small #{translate("this_language_will_be_used_as_the_default")}
												.form-group
													.form-check
														input#peer-review-mode-checkbox.form-check-input(
															type='checkbox'
															name='peerReviewMode'
															checked=peerReviewMode
															onchange='handlePeerReviewModeChange(this.checked); markFormDirty();'
														)
														label.form-check-label(for='peer-review-mode-checkbox')
															| #{translate("peer_review_mode")}
													p.small #{translate("peer_review_mode_description")}
												.form-group
													.form-check
														input#registration-enabled-checkbox.form-check-input(
															type='checkbox'
															name='registrationEnabled'
															checked=registrationEnabled
															disabled=peerReviewMode
															onchange='markFormDirty()'
														)
														label.form-check-label(for='registration-enabled-checkbox')
															| #{translate("allow_users_to_register_new_accounts")}
													p.small #{translate("control_whether_users_can_register")}
												.form-group
													.form-check
														input#disable-chat-checkbox.form-check-input(
															type='checkbox'
															name='disableChat'
															checked=disableChat
															onchange='markFormDirty()'
														)
														label.form-check-label(for='disable-chat-checkbox')
															| #{translate("disable_chat")}
													p.small #{translate("disable_chat_description")}
												.form-group
													.form-check
														input#disable-link-sharing-checkbox.form-check-input(
															type='checkbox'
															name='disableLinkSharing'
															checked=disableLinkSharing
															onchange='markFormDirty()'
														)
														label.form-check-label(for='disable-link-sharing-checkbox')
															| #{translate("disable_link_sharing")}
													p.small #{translate("disable_link_sharing_description")}
												.form-group
													label.form-label(for='admin-email') #{translate("admin_email")}
													input#admin-email.form-control(
														type='email'
														name='adminEmail'
														value=adminEmail
														onchange='markFormDirty()'
													)
													p.small #{translate("admin_email_description")}
												.form-group
													label.form-label(for='max-doc-length') #{translate("max_doc_length")}
													input#max-doc-length.form-control(
														type='number'
														name='maxDocLength'
														value=maxDocLength
														min='1'
														step='1'
														onchange='markFormDirty()'
													)
													p.small #{translate("max_doc_length_description")}
												.form-group
													label.form-label(for='max-upload-size') #{translate("max_upload_size")}
													input#max-upload-size.form-control(
														type='number'
														name='maxUploadSize'
														value=maxUploadSize
														min='1'
														step='1'
														onchange='markFormDirty()'
													)
													p.small #{translate("max_upload_size_description")}
												button.btn.btn-primary(type='submit') #{translate("save_settings")}
										script(nonce=scriptNonce).
											var formDirty = false;
											function markFormDirty() {
												formDirty = true;
											}
											function handlePeerReviewModeChange(isEnabled) {
												var regCheckbox = document.getElementById('registration-enabled-checkbox');
												regCheckbox.disabled = isEnabled;
												if (isEnabled) {
													regCheckbox.checked = false;
												}
											}
											window.addEventListener('beforeunload', function(e) {
												if (formDirty) {
													e.preventDefault();
													e.returnValue = '';
												}
											});
											document.getElementById('site-settings-form').addEventListener('submit', function() {
												formDirty = false;
											});

									.tab-pane(role='tabpanel' id='service-api')
										.row-spaced
											h3 Service-to-Service API
											p.small Enable API access for external services without browser sessions. All operations are performed as administrator with user context specified via headers.
											
											#service-api-settings(data-csrf=csrfToken)
												.alert.alert-dismissible(style='display:none' id='service-api-alert')
													button.close(type='button' id='service-api-alert-close')
														span &times;
													span#service-api-alert-message
												
												.form-group
													.form-check
														input#service-api-enabled.form-check-input(type='checkbox')
														label.form-check-label(for='service-api-enabled') Enable Service API
													p.small When enabled, external services can access Overleaf API via <code>/service/*</code> endpoints
												
												.form-group
													label.form-label(for='service-api-password') Password
													.input-group
														input#service-api-password.form-control(
															type='password'
															placeholder='Enter password or generate one'
															style='font-family: monospace;'
														)
														button.btn.btn-secondary(type='button' id='service-api-toggle-password' title='Show password' style='border-top-right-radius: 0; border-bottom-right-radius: 0;')
															svg#service-api-toggle-icon(width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='#495057' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round')
																//- Закрытый глаз по умолчанию (пароль скрыт)
																path(d='M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24')
																line(x1='1' y1='1' x2='23' y2='23')
														button.btn.btn-secondary(type='button' id='service-api-generate-password') Generate
													p.small Username is always <code>overleaf</code>. Store this password securely.
												
												.form-group
													.form-check
														input#service-api-localhost-only.form-check-input(type='checkbox')
														label.form-check-label(for='service-api-localhost-only') Restrict to localhost only
													p.small When enabled, Service API will only accept connections from localhost (127.0.0.1)
												
												button.btn.btn-primary(id='service-api-save-button') Save Settings
												
												hr
												
												h4 Usage Example
												pre.
													curl -u overleaf:YOUR_PASSWORD \\
													  -H "X-Overleaf-User-Id: USER_ID" \\
													  http://localhost/service/user/projects
												
												p.small 
													| See 
													a(href='/api_doc/SERVICE_TO_SERVICE_API.md' target='_blank') full documentation
													|  for more details.
										
										script(nonce=scriptNonce).
											// Load Service API settings on page load
											async function loadServiceApiSettings() {
												try {
													const response = await fetch('/admin/service-api/settings');
													const data = await response.json();
													document.getElementById('service-api-enabled').checked = data.enabled;
													document.getElementById('service-api-localhost-only').checked = data.localhostOnly;
													const passwordField = document.getElementById('service-api-password');
													if (data.password) {
														passwordField.value = data.password;
													} else {
													}
												} catch (err) {
													console.error('Failed to load Service API settings:', err);
												}
											}
											
											// Generate random password
											async function generateServiceApiPassword() {
												try {
													const csrf = document.getElementById('service-api-settings').dataset.csrf;
													const response = await fetch('/admin/service-api/generate-password', {
														method: 'POST',
														headers: {
															'X-CSRF-Token': csrf,
															'Content-Type': 'application/json'
														}
													});
													const data = await response.json();
													document.getElementById('service-api-password').value = data.password;
													document.getElementById('service-api-password').type = 'text';
												} catch (err) {
													showServiceApiAlert('Failed to generate password', 'danger');
												}
											}
											
											// Save Service API settings
											async function saveServiceApiSettings() {
												try {
													const csrf = document.getElementById('service-api-settings').dataset.csrf;
													const enabled = document.getElementById('service-api-enabled').checked;
													const password = document.getElementById('service-api-password').value;
													const localhostOnly = document.getElementById('service-api-localhost-only').checked;
													
													const body = { enabled, localhostOnly };
													if (password && password !== '••••••••') {
														body.password = password;
													}
													
													const response = await fetch('/admin/service-api/settings', {
														method: 'POST',
														headers: {
															'X-CSRF-Token': csrf,
															'Content-Type': 'application/json'
														},
														body: JSON.stringify(body)
													});
													
													if (response.ok) {
														showServiceApiAlert('Settings saved successfully. Page will reload...', 'success');
														// Reload page after 3 seconds to allow user to see the message
														setTimeout(() => location.reload(), 3000);
													} else {
														showServiceApiAlert('Failed to save settings', 'danger');
													}
												} catch (err) {
													showServiceApiAlert('Failed to save settings: ' + err.message, 'danger');
												}
											}
											
											// Show alert message
											function showServiceApiAlert(message, type) {
												const alert = document.getElementById('service-api-alert');
												const messageSpan = document.getElementById('service-api-alert-message');
												alert.className = 'alert alert-dismissible alert-' + type;
												messageSpan.textContent = message;
												alert.style.display = 'block';
											}
											
											// Load settings when tab is shown
											document.addEventListener('DOMContentLoaded', function() {
												loadServiceApiSettings();

												// Attach event listeners to buttons
												document.getElementById('service-api-alert-close').addEventListener('click', function() {
													document.getElementById('service-api-alert').style.display = 'none';
												});

												document.getElementById('service-api-toggle-password').addEventListener('click', function() {
													const passwordField = document.getElementById('service-api-password');
													const svg = document.getElementById('service-api-toggle-icon');
													const button = this;
													if (passwordField.type === 'password') {
														// Показать пароль
														passwordField.type = 'text';
														button.title = 'Hide password';
														// Открытый глаз (пароль виден)
														svg.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
													} else {
														// Скрыть пароль
														passwordField.type = 'password';
														button.title = 'Show password';
														// Закрытый глаз (пароль скрыт)
														svg.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
													}
												});

												document.getElementById('service-api-generate-password').addEventListener('click', function() {
													generateServiceApiPassword();
												});

												document.getElementById('service-api-save-button').addEventListener('click', function() {
													saveServiceApiSettings();
												});
											});

									.tab-pane(role='tabpanel' id='open-sockets')
										.row-spaced
											ul
												each agents, url in openSockets
													li #{url} - total : #{agents.length}
														ul
															each agent in agents
																li #{agent}

									.tab-pane(role='tabpanel' id='open-close-editor')
										if hasFeature('saas')
											| #{translate("the_open_close_editor_feature_is_not_available")}
										else
											.row-spaced
												form(method='post' action='/admin/closeEditor')
													input(name='_csrf' type='hidden' value=csrfToken)
													button.btn.btn-danger(type='submit') #{translate("close_editor")}
												p.small #{translate("will_stop_anyone_opening_the_editor")}

											.row-spaced
												form(method='post' action='/admin/disconnectAllUsers')
													input(name='_csrf' type='hidden' value=csrfToken)
													button.btn.btn-danger(type='submit') #{translate("disconnect_all_users")}
												p.small #{translate("will_force_disconnect_all_users")}

											.row-spaced
												form(method='post' action='/admin/openEditor')
													input(name='_csrf' type='hidden' value=csrfToken)
													button.btn.btn-danger(type='submit') #{translate("reopen_editor")}
												p.small #{translate("will_reopen_the_editor_after_closing")}

									if hasFeature('saas')
										.tab-pane(role='tabpanel' id='tpds')
											h3 #{translate("flush_project_to_tpds")}
											.row
												form.col-xs-6(method='post' action='/admin/flushProjectToTpds')
													input(name='_csrf' type='hidden' value=csrfToken)
													.form-group
														label.form-label(for='project-id') #{translate("project_id")}
														input.form-control(
															name='project_id'
															id='project-id'
															type='text'
															required
														)
													.form-group
														button.btn-primary.btn(type='submit') #{translate("flush")}
											hr
											h3 #{translate("poll_dropbox_for_user")}
											.row
												form.col-xs-6(method='post' action='/admin/pollDropboxForUser')
													input(name='_csrf' type='hidden' value=csrfToken)
													.form-group
														label.form-label(for='user-id') #{translate("user_id")}
														input.form-control(name='user_id' id='user-id' type='text' required)
													.form-group
														button.btn-primary.btn(type='submit') #{translate("poll")}
