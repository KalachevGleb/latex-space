extends ../layout-marketing

block content
	main#main-content.content.content-alt
		.container
			.row
				.registration-message
					if sharedProjectData.user_first_name !== undefined
						h1 #{translate("user_wants_you_to_see_project", {username:sharedProjectData.user_first_name, projectname:""})}
							em #{sharedProjectData.project_name}
						div
							| #{translate("join_sl_to_view_project")}.
						div
							| #{translate("already_have_sl_account")}
							|
							a(href='/login') #{translate("login_here")}
					else if newTemplateData.templateName !== undefined
						h1 #{translate("register_to_edit_template", {templateName:newTemplateData.templateName})}

						div #{translate("already_have_sl_account")}
							|
							a(href='/login') #{translate("login_here")}

		.row
			.col-lg-8.offset-lg-2.col-xl-6.offset-xl-3
				.card
					.card-body
						.page-header
							h1 #{translate("register")}
						
						if registrationEnabled
							p Enter your email address to create an account. You will receive an email with instructions to set your password.
							
							form#registerForm(
								name='registerForm'
								data-ol-async-form
								action='/admin/register'
								method='POST'
							)
								input(name='_csrf' type='hidden' value=csrfToken)
								
								div(hidden data-ol-sent)
									.alert.alert-success
										strong Success!
										|  Check your email for activation instructions.
								
								div(data-ol-not-sent)
									+formMessagesNewStyle
									
									div(hidden data-ol-custom-form-message='email-already-registered')
										.alert.alert-danger
											strong Error!
											|  This email is already registered. 
											a(href='/login') Please log in instead.
									
									.form-group
										label(for='email') #{translate("email")}
										input#email.form-control(
											name='email'
											type='email'
											required
											autofocus='true'
											autocomplete='email'
										)
									
									.actions
										button.btn-primary.btn(type='submit' data-ol-disabled-inflight)
											span(data-ol-inflight='idle') #{translate("register")}
											span(hidden data-ol-inflight='pending') Registering…
										
								p.small.text-center.mt-3
									| #{translate("already_have_sl_account")}
									|
									a(href='/login') #{translate("login_here")}
							
							script.
								document.addEventListener('DOMContentLoaded', function() {
									const form = document.getElementById('registerForm');
									if (form) {
										// Подписываемся на событие до отправки формы
										form.addEventListener('submit', function() {
											// Скрываем ошибку при повторной отправке
											const errorDiv = form.querySelector('[data-ol-custom-form-message="email-already-registered"]');
											if (errorDiv) {
												errorDiv.setAttribute('hidden', '');
											}
										});
										
										form.addEventListener('data-ol-form-success', function(e) {
											const data = e.detail;
											// Если есть redir (email не настроен), перенаправляем сразу
											if (data && data.redir) {
												e.preventDefault(); // Останавливаем стандартное поведение (показ success)
												window.location.href = data.redir;
											}
										});
										
										form.addEventListener('data-ol-form-error', function(e) {
											const xhr = e.detail;
											// Проверяем код ошибки 409 (Conflict) - email уже зарегистрирован
											if (xhr && xhr.status === 409) {
												e.preventDefault(); // Останавливаем стандартное поведение
												const errorDiv = form.querySelector('[data-ol-custom-form-message="email-already-registered"]');
												if (errorDiv) {
													errorDiv.removeAttribute('hidden');
												}
												// Скрываем спиннер загрузки
												const submitBtn = form.querySelector('button[type="submit"]');
												if (submitBtn) {
													submitBtn.removeAttribute('data-ol-disabled-inflight');
													setTimeout(function() {
														submitBtn.setAttribute('data-ol-disabled-inflight', '');
													}, 0);
												}
											}
										});
									}
								});
						else
							p
								| User registration is currently disabled.
								| Please contact
								|
								strong #{settings.adminEmail}
								|
								| to create an account.
